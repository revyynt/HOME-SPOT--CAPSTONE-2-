root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Lock files and generated/vendor content are never reformatted.
[package-lock.json]
insert_final_newline = false
indent_size = 2