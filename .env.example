# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored -- never commit it.
# ---------------------------------------------------------------------------

# --- PayMongo (https://developers.paymongo.com) -----------------------------
# Server-side only. NEVER expose the secret key to the browser.
# A key you have pasted into git before must be REVOKED and replaced here.
PAYMONGO_SECRET_KEY=sk_test_REPLACE_ME
PAYMONGO_PUBLIC_KEY=pk_test_REPLACE_ME

# --- Firebase (used to verify ID tokens on /api/*) --------------------------
# projectId must match the project the frontend actually reads/writes.
FIREBASE_PROJECT_ID=capstoneapt-b5681
# This is the Firebase *web* API key. It is public by design, but pair it with
# the locked-down firestore.rules in this repo.
FIREBASE_API_KEY=AIzaSyDfsx3AhGY9YSs73ng2t4s8-Nm76_kQewM

# --- Server behaviour -------------------------------------------------------
# Leave REQUIRE_AUTH=true outside of local testing. Setting it to false makes
# every payment endpoint anonymously callable.
REQUIRE_AUTH=true

# Comma-separated list of browser origins allowed to call /api/*.
ALLOWED_ORIGINS=http://localhost:5050,http://127.0.0.1:5050,http://localhost:5000,http://127.0.0.1:5000

# Shared secret for inbound PayMongo webhooks. PayMongo does not sign payloads,
# so this is the only available control. Send it as the `x-webhook-secret`
# header or a `?secret=` query param.
WEBHOOK_SECRET=generate-a-long-random-string

# Set to true ONLY for a local demo of QR Ph settlement. When false,
# /api/complete-qr-payment returns 403 and QR payments must settle through the
# PayMongo redirect or webhook.
ALLOW_TEST_AUTO_CHARGE=false

# Upper bound for any single payment, in pesos.
MAX_PAYMENT_AMOUNT=200000

# Display name embedded in payment descriptions.
MERCHANT_NAME=MJP Residences